VITE_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key. Recommended for Vercel so account and upload writes do not depend on public Storage policies.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Supabase Storage is preferred for account data when configured.
# Cloudinary is used only when Supabase Storage is not configured.

# Add these variables only if you also want Cloudinary-backed local account storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=