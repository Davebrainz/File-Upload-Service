{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://file-upload-service-ydue.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://file-upload-service-ydue.onrender.com/uploads/:path*"
    }
  ]
}